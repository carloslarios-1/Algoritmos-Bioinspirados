import numpy as np
import random

class AntColony:
    def __init__(self, distancias, n_hormigas, n_iteraciones,
                 decaimiento=0.5, alpha=1, beta=2, Q=100):
        self.distancias = distancias
        self.n_ciudades = len(distancias)
        self.n_hormigas = n_hormigas
        self.n_iteraciones = n_iteraciones
        self.decaimiento = decaimiento
        self.alpha = alpha
        self.beta = beta
        self.Q = Q

        self.feromonas = np.ones((self.n_ciudades, self.n_ciudades))

        with np.errstate(divide='ignore'):
            self.visibilidad = 1 / distancias
        self.visibilidad[distancias == 0] = 0  # evitar división por cero en la diagonal

        self.mejor_ruta = None
        self.mejor_distancia = float('inf')

    def ejecutar(self):
        for iteracion in range(self.n_iteraciones):
            todas_las_rutas = self._construir_rutas()

            self._actualizar_feromonas(todas_las_rutas)

            mejor_de_la_ronda = min(todas_las_rutas, key=lambda x: x[1])
            if mejor_de_la_ronda[1] < self.mejor_distancia:
                self.mejor_ruta = mejor_de_la_ronda[0]
                self.mejor_distancia = mejor_de_la_ronda[1]

            print(f"Iteración {iteracion + 1}/{self.n_iteraciones} "
                  f"-> Mejor distancia hasta ahora: {self.mejor_distancia:.2f}")

        return self.mejor_ruta, self.mejor_distancia

    def _construir_rutas(self):

        rutas = []
        for _ in range(self.n_hormigas):
            ruta = self._construir_una_ruta()
            distancia = self._calcular_distancia(ruta)
            rutas.append((ruta, distancia))
        return rutas

    def _construir_una_ruta(self):
     
        ciudad_inicial = random.randint(0, self.n_ciudades - 1)
        ruta = [ciudad_inicial]
        visitadas = set(ruta)

        while len(ruta) < self.n_ciudades:
            ciudad_actual = ruta[-1]
            siguiente = self._elegir_siguiente_ciudad(ciudad_actual, visitadas)
            ruta.append(siguiente)
            visitadas.add(siguiente)

        return ruta

    def _elegir_siguiente_ciudad(self, ciudad_actual, visitadas):
        feromona = np.copy(self.feromonas[ciudad_actual])
        visibilidad = np.copy(self.visibilidad[ciudad_actual])

        for ciudad in visitadas:
            feromona[ciudad] = 0
            visibilidad[ciudad] = 0

        probabilidades = (feromona ** self.alpha) * (visibilidad ** self.beta)
        suma = probabilidades.sum()

        if suma == 0:
            # Si por alguna razón todas las probabilidades son 0,
            # elegir aleatoriamente entre las ciudades no visitadas
            no_visitadas = [c for c in range(self.n_ciudades) if c not in visitadas]
            return random.choice(no_visitadas)

        probabilidades = probabilidades / suma
        siguiente_ciudad = np.random.choice(range(self.n_ciudades), p=probabilidades)
        return int(siguiente_ciudad)

    def _calcular_distancia(self, ruta):
        distancia_total = 0
        for i in range(len(ruta)):
            ciudad_actual = ruta[i]
            ciudad_siguiente = ruta[(i + 1) % len(ruta)]  # vuelve al inicio al final
            distancia_total += self.distancias[ciudad_actual][ciudad_siguiente]
        return distancia_total

    def _actualizar_feromonas(self, rutas):
        self.feromonas *= (1 - self.decaimiento)

        for ruta, distancia in rutas:
            aporte = self.Q / distancia
            for i in range(len(ruta)):
                ciudad_actual = ruta[i]
                ciudad_siguiente = ruta[(i + 1) % len(ruta)]
                self.feromonas[ciudad_actual][ciudad_siguiente] += aporte
                self.feromonas[ciudad_siguiente][ciudad_actual] += aporte  # simétrico

def generar_matriz_distancias(coordenadas):
    n = len(coordenadas)
    matriz = np.zeros((n, n))
    for i in range(n):
        for j in range(n):
            if i != j:
                x1, y1 = coordenadas[i]
                x2, y2 = coordenadas[j]
                matriz[i][j] = np.sqrt((x1 - x2) ** 2 + (y1 - y2) ** 2)
    return matriz

if __name__ == "__main__":
    random.seed(42)
    np.random.seed(42)

    coordenadas = [(random.randint(0, 100), random.randint(0, 100)) for _ in range(10)]
    distancias = generar_matriz_distancias(coordenadas)

    print("Coordenadas de las ciudades:")
    for i, c in enumerate(coordenadas):
        print(f"  Ciudad {i}: {c}")
    print()

    colonia = AntColony(
        distancias=distancias,
        n_hormigas=15,
        n_iteraciones=50,
        decaimiento=0.5,
        alpha=1,
        beta=2,
        Q=100
    )

    mejor_ruta, mejor_distancia = colonia.ejecutar()

    print()
    print("=" * 50)
    print(f"Mejor ruta encontrada: {mejor_ruta}")
    print(f"Distancia total: {mejor_distancia:.2f}")
